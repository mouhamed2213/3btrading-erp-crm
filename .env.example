# --- Base de données ---
DATABASE_URL="postgresql://votre_utilisateur:votre_mot_de_passe@localhost:5432/3btrading_db?sslmode=prefer"

# --- Authentification ---
# Secret utilisé pour signer les JWT de session. Générer une valeur longue et aléatoire,
# par ex. : openssl rand -hex 32
JWT_SECRET="change-moi-avec-une-valeur-aleatoire-longue"

# --- Stockage fichiers (S3-compatible : AWS S3, SeaweedFS, MinIO...) ---
# URL du endpoint S3. Laisser vide pour AWS S3 (le SDK utilise l'endpoint par défaut de la région).
# Pour SeaweedFS/MinIO en local, ex: http://localhost:8333
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="3btrading"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# "true" pour SeaweedFS/MinIO (URLs de type http://host/bucket/key)
# "false" pour AWS S3 classique (URLs de type http://bucket.s3.amazonaws.com/key)
S3_FORCE_PATH_STYLE="true"
# Optionnel : URL publique de base si le bucket est accessible directement (CDN, bucket public).
# Si vide, les fichiers sont servis via le proxy /files/* du serveur (URL S3 présignée à la volée).
S3_PUBLIC_BASE_URL=""

# --- Serveur ---
NODE_ENV="development"
PORT=3000
