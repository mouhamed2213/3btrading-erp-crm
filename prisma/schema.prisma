// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USERS (AUTH)
// ============================================================================
model User {
  id            Int     @id @default(autoincrement())
  openId        String  @unique 
  name          String?
  email         String? 
  loginMethod   String? 
  role          Role    @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSignedIn  DateTime @default(now())

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

// ============================================================================
// CLIENTS
// ============================================================================
model Client {
  id            String   @id 
  nom           String   
  email         String?  
  telephone     String?  
  adresse       String?  @db.Text
  typeClient    TypeClient @default(STANDARD)
  solde         Decimal  @default(0) @db.Decimal(15, 2)
  dateCreation  DateTime @default(now())
  contact       String?  
  siret         String?  
  updatedAt     DateTime @updatedAt

  chantiers     Chantier[]
  locations     Location[]
  factures      Facture[]

  @@map("clients")
}

enum TypeClient {
  STANDARD
  PARTENAIRE
}

// ============================================================================
// MACHINES
// ============================================================================
model Machine {
  id                String   @id 
  nom               String   
  type              String   
  marque            String   
  modele            String?  
  annee             Int?
  immatriculation   String?
  statut            StatutMachine @default(DISPONIBLE)
  tarifJournalier   Decimal  @db.Decimal(15, 2)
  tarifRotation     Decimal? @db.Decimal(15, 2)
  tarifDegressif    Decimal? @db.Decimal(15, 2)
  prixVente         Decimal? @db.Decimal(15, 2)
  enVente           Boolean  @default(false)
  enLocation        Boolean  @default(false)
  description       String?  @db.Text
  images            Json     @default("[]")
  specifications    Json     @default("{}")
  isPublished       Boolean  @default(false)
  isFeatured        Boolean  @default(false)
  dateCreation      DateTime @default(now())
  updatedAt         DateTime @updatedAt

  locations         Location[]
  interventions     Intervention[]

  @@map("machines")
}

enum StatutMachine {
  DISPONIBLE
  EN_LOCATION
  EN_MAINTENANCE
  VENDUE
}

// ============================================================================
// CHANTIERS (PRESTATIONS)
// ============================================================================
model Chantier {
  id                String   @id 
  clientId          String   
  titre             String   
  description       String?  @db.Text
  typesTravaux      Json     // Array of work types
  modeFacturation   ModeFacturation
  dateDebut         DateTime
  dateFin           DateTime?
  statut            StatutChantier @default(PLANIFIE)
  montantEstime     Decimal  @db.Decimal(15, 2)
  montantReel       Decimal? @db.Decimal(15, 2)
  volume            Decimal? @db.Decimal(12, 2) // m³ pour CUBAGE
  heures            Decimal? @db.Decimal(12, 2) // pour HORAIRE
  jours             Int?     // pour JOURNALIER
  dateCreation      DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("chantiers")
}

enum ModeFacturation {
  FORFAIT
  CUBAGE
  HORAIRE
  JOURNALIER
}

enum StatutChantier {
  PLANIFIE
  EN_COURS
  TERMINE
  FACTURE
}

// ============================================================================
// LOCATIONS
// ============================================================================
model Location {
  id            String   @id 
  machineId     String   
  clientId      String   
  dateDebut     DateTime
  dateFin       DateTime
  jours         Int
  tarifType     TarifType
  montantTotal  Decimal  @db.Decimal(15, 2)
  montantPaye   Decimal  @default(0) @db.Decimal(15, 2)
  modePaiement  ModePaiement?
  statut        StatutLocation @default(RESERVEE)
  dateCreation  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  machine       Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([clientId])
  @@map("locations")
}

enum TarifType {
  JOURNALIER
  ROTATION
  DEGRESSIF
}

enum StatutLocation {
  RESERVEE
  SORTIE
  RETOURNEE
}

// ============================================================================
// PIECES DETACHEES
// ============================================================================
model Piece {
  id            String   @id 
  reference     String   @unique 
  nom           String   
  marque        String   
  famille       String   
  compatibilites Json    // Array of machine IDs
  stock         Int      @default(0)
  seuilAlerte   Int      @default(5)
  prixUnitaire  Decimal  @db.Decimal(15, 2)
  fournisseur   String?  
  oemReference  String?
  description   String?  @db.Text
  images        Json     @default("[]")
  specifications Json    @default("{}")
  isPublished   Boolean  @default(false)
  dateCreation  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("pieces")
}

// ============================================================================
// INTERVENTIONS ATELIER
// ============================================================================
model Intervention {
  id            String   @id 
  machineId     String   
  type          TypeIntervention
  description   String   @db.Text
  dateDebut     DateTime
  dateFin       DateTime?
  piecesUtilisees Json   // Array of { pieceId, quantite, prixUnitaire }
  coutEstime    Decimal  @db.Decimal(15, 2)
  coutReel      Decimal? @db.Decimal(15, 2)
  statut        StatutIntervention @default(EN_COURS)
  dateCreation  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  machine       Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@map("interventions")
}

enum TypeIntervention {
  MAINTENANCE_INTERNE
  REPARATION_EXTERNE
  SAV_GARANTIE
}

enum StatutIntervention {
  EN_COURS
  TERMINE
  EN_ATTENTE
}

// ============================================================================
// FACTURES
// ============================================================================
model Facture {
  id            String   @id 
  numero        String   @unique 
  clientId      String   
  type          TypeFacture
  dateEmission  DateTime
  dateEcheance  DateTime?
  montantHT     Decimal  @db.Decimal(15, 2)
  tauxTVA       Decimal  @default(18) @db.Decimal(5, 2)
  montantTVA    Decimal  @db.Decimal(15, 2)
  montantTTC    Decimal  @db.Decimal(15, 2)
  statut        StatutFacture @default(BROUILLON)
  modePaiement  ModePaiement?
  montantPaye   Decimal  @default(0) @db.Decimal(15, 2)
  datePaiement  DateTime?
  dateRelance   DateTime?
  nombreRelances Int     @default(0)
  dateCreation  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("factures")
}

enum TypeFacture {
  PROFORMA
  ACOMPTE
  DEFINITIVE
}

enum StatutFacture {
  BROUILLON
  EMISE
  PAYEE
  IMPAYEE
  PARTIELLEMENT_PAYEE
}

enum ModePaiement {
  CASH
  MOBILE_MONEY
}
